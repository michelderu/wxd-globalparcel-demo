# =============================================================================
# watsonx Orchestrate Developer Edition — ADK environment file
# =============================================================================
#
# Copy to .env and fill in ONE authentication block below.
# Official reference:
# https://developer.watson-orchestrate.ibm.com/developer_edition/wxOde_setup
#
# SECURITY: Never commit .env to version control.
# =============================================================================

# =============================================================================
# AUTHENTICATION (choose ONE method)
# =============================================================================

# --- Method A: watsonx Orchestrate SaaS / 30-day trial ---
# WO_DEVELOPER_EDITION_SOURCE=orchestrate
# WO_INSTANCE=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/<your-instance-id>
# WO_API_KEY=<wxo-api-key>

# --- Method B: myIBM entitlement (recommended for workshops) ---
WO_DEVELOPER_EDITION_SOURCE=myibm
WO_ENTITLEMENT_KEY=<myibm-entitlement-key>
WATSONX_APIKEY=<watsonx-ai-api-key>
WATSONX_SPACE_ID=<watsonx-deployment-space-id>
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Method C: Custom image registry (advanced) ---
# WO_DEVELOPER_EDITION_SOURCE=custom
# REGISTRY_URL=<registry-host>
# REGISTRY_USERNAME=<username>
# REGISTRY_PASSWORD=<password>

# =============================================================================
# EMBEDDED SERVICE CREDENTIALS (Developer Edition)
# =============================================================================
# Replace defaults before shared environments. Passwords must be 18+ characters
# when the ADK prompts during first-time setup.

MINIO_ROOT_USER=minioadmin
LANGFUSE_USERNAME=orchestrate
MCP_GATEWAY_BASIC_USER=admin
CLICKHOUSE_USER=clickhouse

POSTGRES_PASSWORD=change-me-postgres-18chars
MINIO_ROOT_PASSWORD=change-me-minio-18chars
LANGFUSE_PASSWORD=change-me-langfuse-18
MCP_GATEWAY_BASIC_PASSWORD=change-me-mcp-basic-18
MCP_GATEWAY_ADMIN_PASSWORD=change-me-mcp-admin-18
CLICKHOUSE_PASSWORD=change-me-clickhouse-18
ES_PASSWORD=change-me-elasticsearch-18
MILVUS_PASSWORD=change-me-milvus-18chars
# 32-char hex key for encrypting sensitive DB fields (ADK compose name: DB_ENCRYPTION_KEY).
# Workshop default below is fine for local dev; for shared hosts run: openssl rand -hex 16
DB_ENCRYPTION_KEY=7f3a9c2e8b1d4f6a0e5c8b2d9f1a4e7c

# =============================================================================
# REGIONAL ENDPOINTS (non-us-south only)
# =============================================================================
# ASSISTANT_LLM_API_BASE=https://<region>.ml.cloud.ibm.com/
# ASSISTANT_EMBEDDINGS_API_BASE=https://<region>.ml.cloud.ibm.com/
# ROUTING_LLM_API_BASE=https://<region>.ml.cloud.ibm.com/
# WATSONX_URL=https://<region>.ml.cloud.ibm.com/

# =============================================================================
# LANGFLOW (Developer Edition --with-langflow)
# =============================================================================
# Stock ADK compose does not forward extra LANGFLOW_* keys. After pip install:
#   python scripts/patch_langflow_ssrf.py
# or start with: ./scripts/start_wxo.sh
LANGFLOW_SSRF_PROTECTION_ENABLED=false
